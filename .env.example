# ---------------------------------------------------------------- database
# Any PostgreSQL 14+ connection string. Free options that work well on Vercel:
#   • Neon        https://neon.tech            (Vercel Marketplace → Neon)
#   • Supabase    https://supabase.com
# Use the *pooled* connection string when the provider offers one.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ------------------------------------------------------------------- auth
# Any random string of 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# ------------------------------------------------ first administrator user
# Only read by `npm run db:setup`.
ADMIN_EMAIL="admin@example.gov.np"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Portal Administrator"

# ---------------------------------------------------------- file storage
# OPTIONAL. Leave unset and uploaded forms are stored inside Postgres, which
# needs no extra service. Set it (Vercel → Storage → Blob) once the form
# library grows large or files exceed a few megabytes.
# BLOB_READ_WRITE_TOKEN=""
# MAX_UPLOAD_MB="20"

# ------------------------------------------------------------- branding
NEXT_PUBLIC_MUNICIPALITY_NAME_NE="नमुना नगरपालिका"
NEXT_PUBLIC_MUNICIPALITY_NAME_EN="Sample Municipality"
NEXT_PUBLIC_MUNICIPALITY_ADDRESS_NE="नगर कार्यपालिकाको कार्यालय, नेपाल"
NEXT_PUBLIC_MUNICIPALITY_ADDRESS_EN="Office of the Municipal Executive, Nepal"
NEXT_PUBLIC_PROVINCE_NE=""
NEXT_PUBLIC_PROVINCE_EN=""
NEXT_PUBLIC_DISTRICT_NE=""
NEXT_PUBLIC_DISTRICT_EN=""
NEXT_PUBLIC_MUNICIPALITY_PHONE="+977-00-000000"
NEXT_PUBLIC_MUNICIPALITY_EMAIL="info@example.gov.np"
NEXT_PUBLIC_MUNICIPALITY_WEBSITE=""
# Put your own logo in /public and point this at it, e.g. /logo.png
NEXT_PUBLIC_MUNICIPALITY_LOGO="/emblem.svg"

# Number of wards created by `npm run db:seed`
SEED_WARD_COUNT="12"
